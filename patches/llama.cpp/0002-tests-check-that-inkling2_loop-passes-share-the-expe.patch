+// inkling2_loop shares the weights of the core layers with the cache slots of the later passes.
+// Halving the routed-expert weights of the core layer and doubling their ".scale" must leave the logits
+// unchanged, which holds only if the second pass (slot 3) reads the scales of physical layer 1.
+// Power-of-2 rescaling is exact and the CPU graph is deterministic, so the checks compare bit-exactly.
+static int test_loop_scales(const size_t seed, const float stdev) {
+    const llm_arch arch  = LLM_ARCH_INKLING2_LOOP;
+    const int      core  = 1; // prelude 0, core 1, coda 2, see get_gguf_ctx
+    const int      slot2 = 3; // the cache slot of the second pass over the core
+
+    const std::vector<llama_token> tokens = get_tokens(32, 128, seed);
+
+    auto logits_for = [&](int layer, bool weights) {
+        g_expert_rescale.layer   = layer;
+        g_expert_rescale.factor  = 2.0f;
+        g_expert_rescale.weights = weights;
+        gguf_context_ptr gguf_ctx = get_gguf_ctx(arch, /*moe =*/ true);
+        auto model_ctx = get_model_and_ctx(gguf_ctx.get(), nullptr, seed, stdev, {});
+        g_expert_rescale.layer = -1;
+        return get_logits(model_ctx.first.get(), model_ctx.second.get(), tokens);
+    };
+
+    const std::vector<float> ref    = logits_for(-1,    false);
+    const std::vector<float> folded = logits_for(core,  true);  // must match ref
+    const std::vector<float> scaled = logits_for(core,  false); // must differ, else the test cannot see scales
+    const std::vector<float> unused = logits_for(slot2, false); // must match ref, the slot has no scales of its own
+
+    const double e_folded = nmse(ref, folded);
+    const double e_scaled = nmse(ref, scaled);
+    const double e_unused = nmse(ref, unused);
+
+    const bool ok_folded = e_folded == 0.0;
+    const bool ok_scaled = e_scaled >  0.0;
+    const bool ok_unused = e_unused == 0.0;
+
+    LOG("loop-scales: fold weights/2 scale*2 on blk.%d: nmse %.3e (%s)\n", core,  e_folded, ok_folded ? "OK" : "FAIL");
+    LOG("loop-scales: scale*2 only on blk.%d:          nmse %.3e (%s)\n", core,  e_scaled, ok_scaled ? "OK" : "FAIL, no sensitivity");
+    LOG("loop-scales: scale*2 only on slot blk.%d:     nmse %.3e (%s)\n", slot2, e_unused, ok_unused ? "OK" : "FAIL");
+
+    return ok_folded && ok_scaled && ok_unused ? 0 : 1;
+}
+
