 // fills the values of one tensor, the name carries whatever the property needs
 typedef void (*tensor_filler)(std::vector<float> & dst, const char * name, const tensor_data_params & params);
 
+// --loop-scales: rescales the routed-expert tensors of one layer after filling,
+// the ".scale" tensors by factor and, if weights is set, the expert weights by 1/factor
+static struct {
+    int   layer   = -1;
+    float factor  = 1.0f;
+    bool  weights = false;
+} g_expert_rescale;
+
+static void apply_expert_rescale(std::vector<float> & dst, const char * name) {
+    if (g_expert_rescale.layer < 0) {
+        return;
+    }
+    const std::string s      = name;
+    const std::string prefix = "blk." + std::to_string(g_expert_rescale.layer) + ".";
+    if (s.rfind(prefix, 0) != 0 ||
+        (s.find(".ffn_gate_up_exps.") == std::string::npos && s.find(".ffn_down_exps.") == std::string::npos)) {
+        return;
+    }
+    const bool is_scale = s.size() >= 6 && s.compare(s.size() - 6, 6, ".scale") == 0;
+    if (!is_scale && !g_expert_rescale.weights) {
+        return;
+    }
+    const float mul = is_scale ? g_expert_rescale.factor : 1.0f/g_expert_rescale.factor;
+    for (float & v : dst) {
+        v *= mul;
+    }
+}
+
 // a pool of normal draws, generated once and reused for every model
