 test

---
 tests/test-llama-archs.cpp | 93 ++++++++++++++++++++++----------------
 1 file changed, 54 insertions(+), 39 deletions(-)

diff --git a/tests/test-llama-archs.cpp b/tests/test-llama-archs.cpp
index 20aae5d4c..cef67bb99 100644
--- a/tests/test-llama-archs.cpp
+++ b/tests/test-llama-archs.cpp
@@ -64,19 +64,23 @@ static struct {
     bool  weights = false;
 } g_expert_rescale;
 
-// --loop-slots: fills the routed experts of one cache slot with the values of its physical layer
+// --loop-slots: fills the routed experts of the listed cache slots with the values of their physical layer
 static struct {
-    std::string slot; // e.g. "blk.3."
-    std::string phys; // e.g. "blk.1."
+    std::vector<std::string> slots; // e.g. "blk.3."
+    std::string phys;               // e.g. "blk.1."
 } g_slot_alias;
 
 static std::string fill_key(const char * name) {
     const std::string s = name;
-    if (g_slot_alias.slot.empty() || s.rfind(g_slot_alias.slot, 0) != 0 ||
-        (s.find(".ffn_gate_up_exps.") == std::string::npos && s.find(".ffn_down_exps.") == std::string::npos)) {
+    if (s.find(".ffn_gate_up_exps.") == std::string::npos && s.find(".ffn_down_exps.") == std::string::npos) {
         return s;
     }
-    return g_slot_alias.phys + s.substr(g_slot_alias.slot.size());
+    for (const std::string & slot : g_slot_alias.slots) {
+        if (s.rfind(slot, 0) == 0) {
+            return g_slot_alias.phys + s.substr(slot.size());
+        }
+    }
