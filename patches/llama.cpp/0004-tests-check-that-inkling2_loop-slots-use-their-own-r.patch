+// A cache slot may carry its own routed experts, used only by its pass. With the slot's tensors filled with
+// the values of its physical layer the logits must not change; with other values, or a rescaled slot scale,
+// they must, which shows that the second pass reads the slot's tensors and scales.
+static int test_loop_slots(const size_t seed, const float stdev) {
+    const llm_arch arch = LLM_ARCH_INKLING2_LOOP;
+    const std::vector<llama_token> tokens = get_tokens(32, 128, seed);
+
+    auto logits_for = [&](bool slot_tensors, bool alias, int rescale_layer) {
+        g_slot_alias.slot = alias ? "blk.3." : "";
+        g_slot_alias.phys = alias ? "blk.1." : "";
+        g_expert_rescale.layer   = rescale_layer;
+        g_expert_rescale.factor  = 2.0f;
+        g_expert_rescale.weights = false;
+        gguf_context_ptr gguf_ctx = get_gguf_ctx(arch, /*moe =*/ true);
+        if (slot_tensors) {
+            // the slot of the second pass over the core (physical layer 1), see get_gguf_ctx
+            for (const char * name : { "blk.3.ffn_gate_up_exps.weight", "blk.3.ffn_down_exps.weight" }) {
+                ggml_tensor t;
+                memset(&t, 0, sizeof(ggml_tensor));
+                t.type = GGML_TYPE_F32;
+                ggml_set_name(&t, name);
+                gguf_add_tensor(gguf_ctx.get(), &t);
+            }
+        }
+        auto model_ctx = get_model_and_ctx(gguf_ctx.get(), nullptr, seed, stdev, {});
+        g_slot_alias = {};
+        g_expert_rescale.layer = -1;
+        return get_logits(model_ctx.first.get(), model_ctx.second.get(), tokens);
+    };
+
+    const std::vector<float> ref    = logits_for(false, false, -1);
+    const std::vector<float> same   = logits_for(true,  true,  -1); // slot holds the physical values: must match ref
+    const std::vector<float> own    = logits_for(true,  false, -1); // slot holds other values: must differ
+    const std::vector<float> scaled = logits_for(true,  true,   3); // slot scale doubled: must differ
+
+    const double e_same   = nmse(ref, same);
+    const double e_own    = nmse(ref, own);
+    const double e_scaled = nmse(ref, scaled);
+
+    const bool ok_same   = e_same   == 0.0;
+    const bool ok_own    = e_own    >  0.0;
+    const bool ok_scaled = e_scaled >  0.0;
+
+    LOG("loop-slots: slot blk.3 = physical values:   nmse %.3e (%s)\n", e_same,   ok_same   ? "OK" : "FAIL");
+    LOG("loop-slots: slot blk.3 = own values:        nmse %.3e (%s)\n", e_own,    ok_own    ? "OK" : "FAIL, slot tensors unused");
+    LOG("loop-slots: slot blk.3 scale*2:             nmse %.3e (%s)\n", e_scaled, ok_scaled ? "OK" : "FAIL, slot scale unused");
+
+    return ok_same && ok_own && ok_scaled ? 0 : 1;
+}
+
